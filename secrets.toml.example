# Example Secrets File for DigiHealth AI Patient
# Copy this file to .streamlit/secrets.toml and fill in your real credentials

# Google Gemini AI API Key
# Get this from: https://aistudio.google.com/
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"

# Google Cloud Platform Service Account Credentials
# Get this from Google Cloud Console > Service Account > Create Key (JSON)
# This service account is used for:
# - Google Sheets (session logging)
# - Google Drive (file access)
# - Speech-to-Text (Voice Mode)
# - Text-to-Speech (Voice Mode)
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR PRIVATE KEY HERE (keep the line breaks or \n characters)
-----END PRIVATE KEY-----
"""
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account-email"

# ============================================================================
# Voice Mode Settings (Optional)
# ============================================================================
# These settings are optional. If not specified, defaults from voice_config.py will be used.
# Uncomment and modify as needed.

# [voice]
# # TTS voice name (optional - uses default if not set)
# # Thai voices: "th-TH-Standard-A" (female), "th-TH-Wavenet-A" (female, higher quality)
# tts_voice_name = "th-TH-Standard-A"
#
# # Auto-play TTS audio in chat (default: true)
# tts_auto_play = true
#
# # Enable minimal UI for voice mode (default: false)
# # When true: Shows only mic button, no transcript displayed
# voice_minimal_ui = false

# ============================================================================
# Logging Settings (Optional)
# ============================================================================
# Customize Google Sheet IDs for session logging. If not specified,
# hardcoded defaults in app.py will be used.

# [logging]
# # Google Sheet ID for main session log (append mode)
# sheet_id = "your-google-sheet-id"
#
# # Google Sheet ID for latest session data (overwrite mode)
# sheet_latest_id = "your-google-sheet-latest-id"

# ============================================================================
# Debug Settings (Optional)
# ============================================================================
# Enable debug features for troubleshooting. All debug options default to false.

# [debug]
# # Show voice service debug info widget on mode selection page
# # Displays safe credential status info (no secrets exposed)
# voice_status = false
